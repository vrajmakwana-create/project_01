# Environment Selection (dev, prod, test)
ENV=dev

# Application Settings
APP_NAME="01 Project"

# Database Configuration
# Example PostgreSQL (psycopg): postgresql://username:password@localhost:5432/db_name
# Example PostgreSQL (psycopg2): postgresql+psycopg2://username:password@localhost:5432/db_name
# Example SQLite: sqlite:///./app.db
DATABASE_URL=postgresql://postgres:vraj@localhost:5432/project_db

# JWT Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=60
JWT_REFRESH_TOKEN_EXPIRY=1440

# Third-Party Services (Brevo Email Service)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME="01 Project"
