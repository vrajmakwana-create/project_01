# Environment Selection (dev, prod, test)
ENV=dev

# Application Settings
APP_NAME="01 Project"

# Database Configuration
# Example PostgreSQL (psycopg): postgresql://username:password@localhost:5432/db_name
# Example PostgreSQL (psycopg2): postgresql+psycopg2://username:password@localhost:5432/db_name
# Example SQLite: sqlite:///./app.db
DATABASE_URL=postgresql://postgres:vraj@localhost:5432/project_db

# JWT Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=60
JWT_REFRESH_TOKEN_EXPIRY=1440

# Third-Party Services (Brevo Email Service)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME="01 Project"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Hugging Face AI Configuration (Optional)
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
